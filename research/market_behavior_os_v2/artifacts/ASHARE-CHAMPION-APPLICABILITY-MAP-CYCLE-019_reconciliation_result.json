      "horizon_sessions": 20
    },
    "INDUSTRY_PERSISTENCE": {
      "definition": "Spearman correlation of PIT-industry 20-session return ranks between the current and immediately preceding scheduled weekly observation",
      "economic_orientation": "HIGH favorable",
      "horizon_sessions": 20
    },
    "SYNCHRONIZATION": {
      "definition": "absolute sign imbalance abs(2 * fraction of PIT-valid stock 20-session returns above zero - 1)",
      "economic_orientation": "LOW favorable differentiation hypothesis",
      "horizon_sessions": 20
    }
