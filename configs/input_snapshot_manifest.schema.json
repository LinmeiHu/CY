{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyq-game.local/schemas/input_snapshot_manifest.schema.json",
  "title": "CYQ-GAME frozen input snapshot manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_id",
    "registry_id",
    "registry_sha256",
    "purpose",
    "hard_valid",
    "scope",
    "bindings",
    "audits"
  ],
  "properties": {
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "registry_id": {
      "type": "string",
      "minLength": 1
    },
    "registry_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "purpose": {
      "enum": [
        "DATA_PREPARATION",
        "SOFTWARE_TEST",
        "CAUSAL_RESEARCH",
        "CHINEXT_PIT_B_RESEARCH",
        "STRICT_ARCHIVAL_RESEARCH"
      ]
    },
    "hard_valid": {
      "type": "boolean"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "audits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage",
        "duplicates",
        "time_travel",
        "consistency",
        "cross_table"
      ],
      "properties": {
        "coverage": {"$ref": "#/$defs/audit"},
        "duplicates": {"$ref": "#/$defs/audit"},
        "time_travel": {"$ref": "#/$defs/audit"},
        "consistency": {"$ref": "#/$defs/audit"},
        "cross_table": {"$ref": "#/$defs/audit"}
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {
          "enum": ["PASS", "FAIL", "NOT_RUN"]
        },
        "evidence": {
          "type": "string"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "asset_id",
        "path",
        "source",
        "snapshot_id",
        "available_at_policy"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "available_at_policy": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "inventory_manifest": {
          "type": "string",
          "minLength": 1
        },
        "inventory_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "oneOf": [
        {
          "required": ["sha256"],
          "not": {
            "anyOf": [
              {"required": ["inventory_manifest"]},
              {"required": ["inventory_sha256"]}
            ]
          }
        },
        {
          "required": ["inventory_manifest", "inventory_sha256"],
          "not": {"required": ["sha256"]}
        }
      ]
    }
  }
}
